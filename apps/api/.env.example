DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carality_assessment"
PORT="4010"

# Auth (optional for dev: if omitted, API will generate an ephemeral RSA keypair on boot)
# Prefer providing fixed keys for stable encryption across restarts.
# - AUTH_RSA_PRIVATE_KEY_B64: base64 of the PEM (PKCS8) private key
# - AUTH_RSA_PUBLIC_KEY_PEM: PEM (SPKI) public key string
# AUTH_RSA_PRIVATE_KEY_B64=""
# AUTH_RSA_PUBLIC_KEY_PEM=""

# Session TTL (days)
# AUTH_SESSION_TTL_DAYS="7"

# Vehicle catalog cache (optional)
# The active vehicle pool is read on every session completion and result page view, so each
# API process caches it briefly. Set 0 to always hit the database.
# VEHICLE_CATALOG_CACHE_TTL_MS="60000"

# Destructive seed guard (apps/api/prisma/seed.ts deletes questions, vehicles, sessions and results)
# Required when the target database already contains users or assessment sessions.
# SEED_CONFIRM_DESTRUCTIVE="YES"
# Required in addition when NODE_ENV=production.
# SEED_ALLOW_PRODUCTION="YES"

# Dongchedi vehicle-series import (optional)
# Keep DONGCHEDI_COOKIE only in local/production env files; never commit a real cookie.
# DONGCHEDI_SERIES_ENDPOINT="https://www.dongchedi.com/motor/pc/car/brand/select_series_v2"
# DONGCHEDI_QUERY_STRING="aid=1839&app_name=auto_web_pc&msToken=xxx&a_bogus=xxx"
# DONGCHEDI_COOKIE="ttwid=...; sessionid=..."
# DONGCHEDI_CITY_NAME="杭州"
# DONGCHEDI_USER_AGENT="Mozilla/5.0 ..."
# DONGCHEDI_REFERER="https://www.dongchedi.com/auto/library/x-0-x-x-x-x-x-x-x-x-x"
# DONGCHEDI_ORIGIN="https://www.dongchedi.com"
